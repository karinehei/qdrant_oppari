[flake8]
max-line-length = 127
max-complexity = 10
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .idea,
    .ipynb_checkpoints,
    build,
    dist,
    *.egg-info
# E203: whitespace before ':'
# E501: line too long (handled by max-line-length)
# W503: line break before binary operator
# F401: imported but unused (handled by other tools)
ignore =
    E203,
    E501,
    W503,
    F401,
